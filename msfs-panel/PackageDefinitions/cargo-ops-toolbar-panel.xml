<?xml version="1.0" encoding="utf-8"?>
<!-- Cargo Ops toolbar panel: package definition. Two asset groups:
     - InGamePanels: the panel definition XML, compiled by the package tool into an .spb;
     - html_ui: the panel page, its script and style and the toolbar icon, copied as they are.
     The built package lands in Packages\cargo-ops-toolbar-panel\ (with the layout.json and
     manifest.json the tool writes) and is copied to the Community folder. -->
<AssetPackage Name="cargo-ops-toolbar-panel" Version="0.1.0">
  <ItemSettings>
    <ContentType>MISC</ContentType>
    <Title>Cargo Ops toolbar panel</Title>
    <Manufacturer/>
    <Creator>Cargo Ops</Creator>
    <Description>Shows the local Cargo Ops page (http://127.0.0.1:4311/panel) in a toolbar window.</Description>
  </ItemSettings>
  <Flags>
    <VisibleInStore>false</VisibleInStore>
    <CanBeReferenced>false</CanBeReferenced>
  </Flags>
  <AssetGroups>
    <AssetGroup Name="cargo-ops-ingamepanel">
      <Type>SPB</Type>
      <Flags>
        <FSXCompatibility>false</FSXCompatibility>
      </Flags>
      <AssetDir>PackageSources\InGamePanels\</AssetDir>
      <OutputDir>InGamePanels\</OutputDir>
    </AssetGroup>
    <AssetGroup Name="cargo-ops-html-ui">
      <Type>Copy</Type>
      <Flags>
        <FSXCompatibility>false</FSXCompatibility>
      </Flags>
      <AssetDir>PackageSources\html_ui\</AssetDir>
      <OutputDir>html_ui\</OutputDir>
    </AssetGroup>
  </AssetGroups>
</AssetPackage>
